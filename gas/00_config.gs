/**
 * まるつけ — 設定とスキーマ定義
 *
 * 列は「見出し名」で引く。手でシートを触って列を入れ替えても壊れないようにするため。
 * 列を消すと壊れるので、消さずに右端へ寄せること。
 */

var SHEETS = {
  TEACHER: '講師',
  STUDENT: '生徒',
  BOOK:    '教材',
  UNIT:    '単元',
  SECTION: '見出し',
  RECORD:  '記録',
  SESSION: 'セッション'
};

/** 各シートの見出し行。初期化時に作られる順序でもある */
var HEADERS = {};

/**
 * 講師シート。
 * 「反復回数」はそのハッシュを作ったときの回数。照合はこの値で行う。
 * あとから AUTH.HASH_ROUNDS を変えても、既存のログインが壊れないようにするため。
 * 古い回数のまま入れた人は、次にログインしたときに今の回数で入れ直す。
 */
HEADERS[SHEETS.TEACHER] = [
  'id', '名前', 'ログインID', 'パスワードハッシュ', 'ソルト', '反復回数', '有効', '作成日時'
];

HEADERS[SHEETS.STUDENT] = [
  'id', '名前', '学年', '有効', '作成日時'
];

HEADERS[SHEETS.BOOK] = [
  'id', '書名', '略称', '科目', '総ページ', '有効', '作成日時'
];

HEADERS[SHEETS.UNIT] = [
  'id', '教材id', '教材略称', '単元名', '開始ページ', '終了ページ'
];

HEADERS[SHEETS.SECTION] = [
  'id', '教材id', '教材略称', '見出し'
];

/**
 * 記録シート。
 * 「生徒名」「教材略称」はシステムは読まない。手で開いたときに読めるようにするための控え。
 * 書き込んだ時点の名前が入るので、あとで改名しても過去の行は変わらない。
 * 結果とつまずきは数値ではなく日本語で入れる。手で直せるようにするため。
 *
 * 「受付キー」は画面側が1件ごとに作る文字列。二重記録を防ぐためだけにある。
 * GAS のウェブアプリは応答が落ちることがあり、そのとき画面は再送する。
 * 同じキーの行が既にあれば、書かずにその行を返す。手で触らないこと。
 */
HEADERS[SHEETS.RECORD] = [
  'id', '日時', '講師id', '講師名',
  '生徒id', '生徒名',
  '教材id', '教材略称', 'ページ', '見出し', '大問', '小問',
  '結果', 'つまずき',
  '受付キー'
];

HEADERS[SHEETS.SESSION] = [
  'token', '講師id', '発行日時', '最終利用日時'
];

/** 結果コード ⇄ シート上の表記 */
var RESULT_TO_TEXT = { 1: '○', 2: '×', 3: '−' };
var TEXT_TO_RESULT = { '○': 1, '×': 2, '−': 3, '-': 3, 'ー': 3, '―': 3 };

/** つまずきコード ⇄ シート上の表記。0（未分類）は空欄 */
var CAUSE_TO_TEXT = { 0: '', 1: 'できる', 2: 'あいまい', 3: '知識なし' };
var TEXT_TO_CAUSE = { '': 0, 'できる': 1, 'あいまい': 2, '知識なし': 3 };

/**
 * 認証まわり。
 *
 * HASH_ROUNDS は実測して決めた値。GAS の Utilities.computeDigest は1回ごとに
 * Java 側を呼ぶので、1万回では 5〜11秒かかった（本番で計測）。
 * 応答が落ちて再送するたびに丸ごと再計算するため、長いほど失敗しやすくなる。
 * 1500回で 0.8〜1.6秒。
 *
 * 総当たりへの強さはこの回数だけでは決まらない。
 * ログイン試行は 5回/15分 で止めてあるので、オンラインからの総当たりは通らない。
 * シートごと漏れた場合の最後の砦はパスワードの長さになる。十分に長いものにすること。
 */
var AUTH = {
  HASH_ROUNDS:     1500,              // パスワードハッシュの反復回数
  LEGACY_ROUNDS:   10000,             // 「反復回数」列が無かった頃の値
  SESSION_HOURS:   12,                // セッションの有効期間
  MAX_FAILURES:    5,                 // この回数を超えたら
  LOCKOUT_MINUTES: 15                 // この時間ログインを止める
};

/** 一度に返す記録の既定期間（日）。指定がなければこの範囲 */
var DEFAULT_RECORD_DAYS = 180;
